[
 {
  "id": "p01",
  "title": "망토",
  "source": "original",
  "difficulty": "implicit",
  "patterns": ["hidden_side", "facing_mismatch"],
  "traps": ["등 돌린 사람의 뒷모습을 봄"],
  "initial_state": {
   "서윤": {"facing": {"도현": "front"}},
   "도현": {"facing": {"서윤": "front"}}
  },
  "sentences": [
   {"text": "서윤은 도현의 말을 끝까지 듣지 않고 몸을 돌렸다.",
    "events": [{"type": "turn", "character": "서윤", "away_from": "도현"}]},
   {"text": "그녀는 망토 깃을 여며 어깨까지 감쌌다.", "events": []},
   {"text": "도현은 망토에 덮인 그 뒷모습을 한참 바라보았다.",
    "events": [{"type": "state", "character": "서윤", "facing": {"도현": "back"}}]},
   {"text": "바람이 불어 망토 자락이 크게 펄럭였다.", "events": []},
   {"text": "서윤이 다시 몸을 돌려 도현을 마주했다.",
    "events": [{"type": "turn", "character": "서윤", "toward": "도현"}]},
   {"text": "도현은 그제야 그녀의 눈가가 붉어진 것을 보았다.",
    "events": [{"type": "see", "character": "도현", "target": "서윤", "part": "face"}]}
  ],
  "errors": [
   {"sentence": 2, "text": "도현은 망토 너머로 그녀가 입술을 깨무는 것을 보았다.",
    "events": [{"type": "see", "character": "도현", "target": "서윤", "part": "face"}],
    "rule": "hidden_side", "note": "서윤은 도현에게 등을 보이고 있다"},
   {"sentence": 3, "text": "서윤은 도현을 마주 본 채 펄럭이는 망토 자락을 움켜쥐었다.",
    "events": [{"type": "state", "character": "서윤", "facing": {"도현": "back"}},
               {"type": "state", "character": "서윤", "facing": {"도현": "front"}}],
    "rule": "facing_mismatch", "note": "돌아서는 행동 없이 마주 본다"}
  ]
 },
